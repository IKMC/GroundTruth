# Backend configuration (copy to .env)
PORT=8787
GENESIS_DATE=2026-10-01
ADMIN_KEY=change-me
# true = accept readings for past days (demo replay). Keep false in production: it lets people
# submit AFTER NASA data exists, which weakens the anti-copying design.
DEMO_REPLAY=true
CORS_ORIGIN=*
DATA_FILE=./data/store.json

# Chain (needed for /admin/commit and /admin/finalize)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ORACLE_ADDRESS=0x...
DEPLOY_BLOCK=0
# Private key of the COMMITTER account set with FieldOracle.setCommitter. Use a throw-away testnet key.
COMMITTER_PRIVATE_KEY=0x...
