pragma solidity ^0.8.24;

import {IERC165} from "@openzeppelin/contracts/utils/introspection/IERC165.sol";
import {Base} from "./Base.t.sol";
import {FieldOracle} from "../src/FieldOracle.sol";
import {IReceiver} from "../src/interfaces/IReceiver.sol";
import {Subscription} from "../src/Subscription.sol";
import {FieldToken} from "../src/FieldToken.sol";

/// @dev Uses test/vectors/epoch1.json, generated by the TypeScript oracle code
///      (workflow/field-workflow/test/gen-vector.ts). If these tests pass, the report encoding
///      and the Merkle proofs built off-chain are accepted by the contract.
contract FieldOracleTest is Base {
    string internal json;
    bytes internal report;
    bytes32 internal batchHash;
    bytes32 internal root;
    bytes32 internal cellId;
    uint256 internal total;

    function setUp() public override {
        super.setUp();
        json = vm.readFile("test/vectors/epoch1.json");
        report = vm.parseJsonBytes(json, ".reportHex");
        batchHash = vm.parseJsonBytes32(json, ".batchHash");
        root = vm.parseJsonBytes32(json, ".rewardRoot");
        cellId = vm.parseJsonBytes32(json, ".cellId");
        total = vm.parseJsonUint(json, ".totalRewards");
    }

    // ------------------------------------------------------------------ helpers

    function _commit(bytes32 h) internal {
        vm.prank(committer);
        oracle.commitBatch(1, h);
    }

    function _deliver(bytes memory r) internal {
        vm.prank(forwarder);
        oracle.onReport("", r);
    }

    function _settleFunded() internal {
        _subscribe(farmer, 1); // reward pool 3.5 mUSDC, the vector needs 1.1
        _commit(batchHash);
        _deliver(report);
    }

    function _volunteer(uint256 i)
        internal
        view
        returns (address who, uint256 amount, bytes32[] memory proof)
    {
        who = vm.parseJsonAddressArray(json, ".volunteers")[i];
        amount = vm.parseJsonUintArray(json, ".amounts")[i];
        proof = vm.parseJsonBytes32Array(json, string.concat(".proofs[", vm.toString(i), "]"));
    }

    // ------------------------------------------------------------------ commit phase

    function test_commit_onlyCommitter() public {
        vm.prank(farmer);
        vm.expectRevert(FieldOracle.NotCommitter.selector);
        oracle.commitBatch(1, batchHash);
    }

    function test_commit_mustBeSequentialAndNonZero() public {
        vm.startPrank(committer);
        vm.expectRevert(abi.encodeWithSelector(FieldOracle.WrongEpoch.selector, 1, 2));
        oracle.commitBatch(2, batchHash);
        vm.expectRevert(FieldOracle.EmptyHash.selector);
        oracle.commitBatch(1, bytes32(0));
        oracle.commitBatch(1, batchHash);
        vm.expectRevert(abi.encodeWithSelector(FieldOracle.WrongEpoch.selector, 2, 1));
        oracle.commitBatch(1, batchHash); // cannot overwrite a commitment
        vm.stopPrank();
        assertEq(oracle.batchCommitment(1), batchHash);
    }

    // ------------------------------------------------------------------ settlement

    function test_onReport_onlyForwarder() public {
        _commit(batchHash);
        vm.expectRevert(
            abi.encodeWithSelector(FieldOracle.InvalidSender.selector, address(this), forwarder)
        );
        oracle.onReport("", report);
    }

    function test_tsReport_settlesAndStoresCell() public {
        _settleFunded();

        assertEq(oracle.lastSettledEpoch(), 1);
        assertEq(oracle.rewardRoot(1), root);
        assertEq(oracle.epochRewards(1), total);

        FieldOracle.StoredCell memory c = oracle.getCell(cellId);
        assertEq(c.epoch, 1);
        assertEq(int256(c.tempBiasX10), vm.parseJsonInt(json, ".expected.tempBiasX10"));
        assertEq(uint256(c.rainRatioBps), vm.parseJsonUint(json, ".expected.rainRatioBps"));
        assertEq(uint256(c.moistureX100), vm.parseJsonUint(json, ".expected.moistureX100"));
        assertEq(uint256(c.qualityBps), vm.parseJsonUint(json, ".expected.qualityBps"));
        assertEq(uint256(c.accepted), vm.parseJsonUint(json, ".expected.accepted"));

        // backing: the oracle reserved USDC for exactly the rewards it created
        assertEq(sub.reserved(), token.usdcValueCeil(total));
    }

    function test_claim_everyVolunteerWithTsProofs() public {
        _settleFunded();
        address[] memory vols = vm.parseJsonAddressArray(json, ".volunteers");
        uint256 minted;
        for (uint256 i = 0; i < vols.length; i++) {
            (address who, uint256 amount, bytes32[] memory proof) = _volunteer(i);
            vm.prank(who);
            oracle.claim(1, amount, proof);
            assertEq(token.balanceOf(who), amount);
            minted += amount;

            vm.prank(who);
            vm.expectRevert(FieldOracle.AlreadyClaimed.selector);
            oracle.claim(1, amount, proof);
        }
        assertEq(minted, total);
        assertEq(oracle.epochClaimed(1), total);
        assertEq(token.totalSupply(), total);
    }

    function test_claim_wrongAmountOrStrangerReverts() public {
        _settleFunded();
        (address who, uint256 amount, bytes32[] memory proof) = _volunteer(0);

        vm.prank(who);
        vm.expectRevert(FieldOracle.InvalidProof.selector);
        oracle.claim(1, amount + 1, proof);

        vm.prank(makeAddr("stranger"));
        vm.expectRevert(FieldOracle.InvalidProof.selector);
        oracle.claim(1, amount, proof);
    }

    function test_claim_beforeSettlementReverts() public {
        (address who, uint256 amount, bytes32[] memory proof) = _volunteer(0);
        vm.prank(who);
        vm.expectRevert(FieldOracle.NoRewards.selector);
        oracle.claim(1, amount, proof);
    }

    // ------------------------------------------------- skipped reports (never reverted)

    function test_mismatchedCommitment_isSkipped() public {
        _subscribe(farmer, 1);
        _commit(keccak256("a different batch")); // the DON fetched data that differs from the commitment
        vm.expectEmit(true, false, false, true);
        emit FieldOracle.EpochSkipped(1, oracle.SKIP_COMMITMENT_MISMATCH());
        _deliver(report);
        assertEq(oracle.lastSettledEpoch(), 0);
        assertEq(sub.reserved(), 0);
    }

    function test_uncommittedEpoch_isSkipped() public {
        vm.expectEmit(true, false, false, true);
        emit FieldOracle.EpochSkipped(1, oracle.SKIP_OUT_OF_ORDER());
        _deliver(report);
        assertEq(oracle.lastSettledEpoch(), 0);
    }

    function test_duplicateReport_isSkippedNotReverted() public {
        _settleFunded();
        uint256 reservedBefore = sub.reserved();
        vm.expectEmit(true, false, false, true);
        emit FieldOracle.EpochSkipped(1, oracle.SKIP_OUT_OF_ORDER());
        _deliver(report);
        assertEq(sub.reserved(), reservedBefore); // no double reservation
    }

    function test_nextEpochCanBeCommittedAfterSettlement() public {
        _settleFunded();
        vm.prank(committer);
        oracle.commitBatch(2, keccak256("epoch 2"));
        assertEq(oracle.lastCommittedEpoch(), 2);
    }

    // ----------------------------------------------------------- funding behaviour

    function test_unfundedEpoch_storesCellsButCreatesNoRewards() public {
        // nobody subscribed: the reward pool is empty
        _commit(batchHash);
        vm.expectEmit(true, false, false, true);
        emit FieldOracle.RewardsUnfunded(1, total);
        _deliver(report);

        assertEq(oracle.lastSettledEpoch(), 1);
        assertEq(oracle.getCell(cellId).accepted, 5); // data still recorded
        assertEq(oracle.rewardRoot(1), bytes32(0));

        (address who, uint256 amount, bytes32[] memory proof) = _volunteer(0);
        vm.prank(who);
        vm.expectRevert(FieldOracle.NoRewards.selector);
        oracle.claim(1, amount, proof);
    }

    function test_availableRewardBudget_tracksThePool() public {
        assertEq(oracle.availableRewardBudget(), 0);
        _subscribe(farmer, 1); // 3.5 mUSDC = 35 FIELD
        assertEq(oracle.availableRewardBudget(), 35e18);
        _commit(batchHash);
        _deliver(report);
        assertEq(
            oracle.availableRewardBudget(), 35e18 - token.fieldValue(token.usdcValueCeil(total))
        );
    }

    function test_malformedReport_qualityAboveMax_reverts() public {
        _commit(batchHash);
        FieldOracle.CellResult[] memory cells = new FieldOracle.CellResult[](1);
        cells[0] = FieldOracle.CellResult(cellId, 0, 10_000, 0, 10_001, 3);
        bytes memory bad = abi.encode(uint256(1), batchHash, bytes32(0), uint256(0), cells);
        vm.prank(forwarder);
        vm.expectRevert(FieldOracle.InvalidReport.selector);
        oracle.onReport("", bad);
    }

    // ------------------------------------------------------------- full lifecycle

    function test_endToEnd_subscribeCommitSettleClaimRedeem() public {
        _settleFunded();
        (address who, uint256 amount, bytes32[] memory proof) = _volunteer(0);

        vm.startPrank(who);
        oracle.claim(1, amount, proof);
        uint256 reservedBefore = sub.reserved();
        token.redeem(amount);
        vm.stopPrank();

        assertEq(token.balanceOf(who), 0);
        assertEq(usdc.balanceOf(who), token.usdcValue(amount));
        assertEq(sub.reserved(), reservedBefore - token.usdcValue(amount));
    }

    // ------------------------------------------------------------------ misc

    function test_supportsInterface() public view {
        assertTrue(oracle.supportsInterface(type(IReceiver).interfaceId));
        assertTrue(oracle.supportsInterface(type(IERC165).interfaceId));
        assertFalse(oracle.supportsInterface(0xdeadbeef));
    }

    function test_constructor_rejectsZeroForwarder() public {
        vm.expectRevert(FieldOracle.ZeroAddress.selector);
        new FieldOracle(address(0), sub, token);
    }

    function test_setCommitter_onlyOwner() public {
        vm.prank(farmer);
        vm.expectRevert();
        oracle.setCommitter(farmer);
    }
}
